{
  "name": "create-jules-kit",
  "version": "0.1.0",
  "description": "Create a Bun-first TanStack Start application.",
  "type": "module",
  "bin": {
    "create-jules-kit": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target=node --format=esm --outfile=dist/cli.js",
    "check": "tsc --noEmit",
    "test": "bun test src",
    "test:scaffold": "node scripts/scaffold-test.mjs",
    "template:build": "node scripts/build-template.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "bun run template:build && bun run check && bun run test && bun run build && bun run test:scaffold && bun run pack:check"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.2.20",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juleshall4/jules-kit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tanstack/cli": "0.70.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  }
}
